PORT=3000
NODE_ENV=development
APP_VERSION=local
GIT_SHA=local
LOG_LEVEL=info
# Hosts liberados no CORS, separados por virgula. Use "*" para liberar qualquer origem.
# Ex.: CORS_ORIGIN=https://app.exemplo.com,http://localhost:5173
CORS_ORIGIN=http://localhost:3000
ENABLE_DEMO_INCIDENTS=true

# Banco de dados PostgreSQL.
# Opcao 1: uma unica connection string (usada pelo Render e pelo docker-compose).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chsrc
# Opcao 2 (alternativa ao DATABASE_URL): variaveis separadas.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=chsrc
# Habilite SSL ao conectar num Postgres gerenciado pela internet (ex.: URL externa do Render).
DB_SSL=false

# Autenticacao (obrigatorio em producao). Usado para assinar/verificar os JWTs.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
